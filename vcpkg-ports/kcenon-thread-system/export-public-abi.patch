diff --git a/cmake/thread_system_install.cmake b/cmake/thread_system_install.cmake
index abb19918..5d8ccf3e 100644
--- a/cmake/thread_system_install.cmake
+++ b/cmake/thread_system_install.cmake
@@ -143,11 +143,11 @@ endfunction()
 # Install pkg-config file
 ##################################################
 function(install_pkgconfig_file)
